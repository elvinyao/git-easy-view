# Field reference only. Prefer: bash .agent/run.sh deploy --production
# The helper generates runtime/production.env with independent secrets.
# Never commit the real file or use these placeholder values.
COMPOSE_PROJECT_NAME=git-easy-view-production
GEV_ENV_FILE=./runtime/production.env
GEV_APP_IMAGE=git-easy-view:git-easy-view-production
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
GEV_DATABASE_URL=postgresql+psycopg://gev:REPLACE_WITH_RANDOM_HEX@postgres:5432/gev
GEV_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
GEV_CREDENTIAL_KEY=REPLACE_WITH_FERNET_KEY
GEV_REDIS_URL=redis://redis:6379/0
GEV_CACHE_ROOT=/data/git
GEV_PRODUCTION=true
GEV_COOKIE_SECURE=true
GEV_PORT=8767
