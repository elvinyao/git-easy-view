# Copy values into the file created by deploy-intranet --init.
# These are literal values, not shell commands. Never source this file.
# Leave proxies empty for direct internet access on a personal computer.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,web
# HTTPS_PROXY usually also uses an http:// proxy URL (HTTP CONNECT).
# Example: HTTPS_PROXY=http://proxy.company.example:8080
# Optional internal Python package mirror; blank uses pip's default.
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
